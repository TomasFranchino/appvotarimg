generator client {
  provider = "prisma-client-js"
}

// Vercel → Storage → Neon (Postgres) crea DATABASE_URL y DATABASE_URL_UNPOOLED automáticamente.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Un curso tiene su propia galería, votación y ranking (link público: /c/<slug>).
model Course {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  votingOpen  Boolean  @default(true)
  showResults Boolean  @default(true)
  createdAt   DateTime @default(now())
  works       Work[]
  ballots     Ballot[]
}

/// Un trabajo = un alumno con su par de imágenes.
model Work {
  id             String     @id @default(cuid())
  courseId       String
  studentName    String
  expectationUrl String
  realityUrl     String
  createdAt      DateTime   @default(now())
  course         Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  voteItems      VoteItem[]

  @@index([courseId])
}

/// Un voto completo (boleta) emitido por un navegador en un curso.
model Ballot {
  id          String     @id @default(cuid())
  courseId    String
  fingerprint String
  nickname    String?
  createdAt   DateTime   @default(now())
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items       VoteItem[]

  // Un mismo dispositivo vota una vez por curso.
  @@unique([courseId, fingerprint])
}

/// Cada boleta tiene exactamente 3 ítems: 3, 2 y 1 punto a trabajos distintos.
model VoteItem {
  id       String @id @default(cuid())
  ballotId String
  workId   String
  points   Int
  ballot   Ballot @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  work     Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([ballotId, workId])
  @@unique([ballotId, points])
  @@index([workId])
}
