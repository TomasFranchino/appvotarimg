# ── Base de datos (Vercel → Storage → Neon Postgres) ──────────────────────────
# Al conectar la base al proyecto, Vercel crea estas variables solo.
DATABASE_URL="postgresql://usuario:clave@host-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require"

# ── Imágenes (Vercel → Storage → Blob, acceso PÚBLICO) ────────────────────────
# También la crea Vercel al conectar el Blob store.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ── Panel de administración ──────────────────────────────────────────────────
# Esta sí la tenés que crear vos.
ADMIN_PASSWORD="elegi-una-clave-segura"
